{
  "schema": 1,
  "name": "package-cpp",
  "organization": "gardusi-gustavo",
  "layer": 2,
  "kind": "library",
  "visibility": "public",
  "platforms": [
    "gitea",
    "github"
  ],
  "features": {
    "ci": true,
    "pages": false,
    "release": true,
    "observability": false
  },
  "limits": {
    "repo_mb": 100,
    "file_mb": 25,
    "max_symlinks": 0
  },
  "ci": {
    "profile": "cpp",
    "script": "infra/scripts/ci.sh",
    "timeout_minutes": 15,
    "required_jobs": [
      "ci"
    ],
    "primary": "gitea"
  },
  "versioning": {
    "scheme": "semver",
    "tag_prefix": "v",
    "release_artifacts": true
  },
  "dependencies": {
    "templates/yml": "v0.2.0",
    "templates/json": "v0.2.1",
    "templates/sh": "v0.6.3",
    "templates/md": "v0.3.1",
    "templates/git": "v0.1.1"
  },
  "depends_on": [],
  "consumers": [],
  "data_classification": "public",
  "files": {
    "infra_max_file_mb": 1,
    "rules": {
      "": {
        "allow_names": [
          "README.md",
          "AGENTS.md",
          ".gitignore",
          ".gitattributes",
          ".dockerignore",
          "VERSION",
          ".markdownlint.json",
          "CMakeLists.txt"
        ],
        "allow_globs": []
      },
      "docs/": {
        "allow_extensions": [
          ".md"
        ],
        "allow_names": [
          ".gitkeep"
        ]
      },
      "docs/issues/": {
        "allow_extensions": [
          ".json",
          ".md"
        ],
        "allow_names": []
      },
      "src/": {
        "allow_extensions": [
          ".cpp",
          ".hpp",
          ".h"
        ],
        "allow_names": [
          ".gitkeep"
        ]
      },
      "infra/config/": {
        "allow_extensions": [
          ".json"
        ]
      },
      "infra/templates/": {
        "allow": [
          "*"
        ]
      },
      ".gitea/workflows/": {
        "allow_extensions": [
          ".yml",
          ".yaml"
        ]
      },
      ".gitea/issue_template/": {
        "allow_extensions": [
          ".md",
          ".yml",
          ".yaml"
        ]
      },
      ".gitea/": {
        "allow_names": [
          "pull_request_template.md"
        ]
      },
      ".github/": {
        "allow_globs": [
          "*"
        ],
        "allow_names": [
          "CODEOWNERS"
        ]
      },
      ".github/workflows/": {
        "allow_extensions": [
          ".yml",
          ".yaml"
        ]
      },
      ".github/ISSUE_TEMPLATE/": {
        "allow_extensions": [
          ".yml",
          ".yaml",
          ".md"
        ]
      },
      "infra/scripts/": {
        "allow_extensions": [
          ".sh"
        ]
      },
      "infra/docker/": {
        "allow_globs": [
          "*.dockerfile"
        ]
      }
    },
    "forbid": [
      {
        "regex": "(^|/)[^/]*\\.md$",
        "reason": "Markdown is allowed only in docs/, .gitea/, README.md, and AGENTS.md",
        "allow": [
          "^README\\.md$",
          "^AGENTS\\.md$",
          "^docs/",
          "^\\.gitea/",
          "^infra/templates/",
          "^\\.github/"
        ]
      },
      {
        "regex": "^infra/data/",
        "reason": "infra/data is retired; use src/data"
      },
      {
        "regex": "^\\.gitlab-ci\\.yml$",
        "reason": "GitLab is not a source"
      }
    ]
  }
}
